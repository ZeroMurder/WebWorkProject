@model WebWorkNew.Models.Project
@{
    ViewData["Title"] = "Удаление проекта";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2> Удаление проекта</h2>

<div class="card" style="background:#fff3e0; border-left: 4px solid #ff9800;">
    <p>Вы уверены, что хотите удалить проект <strong>@Model.Title</strong>?</p>
    <p>Это действие удалит все связанные ресурсы и не может быть отменено.</p>
</div>

<form method="post" asp-action="DeleteConfirmed">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn" style="background:#dc3545;"> Да, удалить</button>
    <a href="/Projects" class="btn-secondary"> Отмена</a>
</form>