@model WebWork.Models.Project
@{
    ViewData["Title"] = "Создание проекта";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>➕ Создание проекта</h2>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    
    <div class="field">
        <label>📌 Название проекта</label>
        <input asp-for="Title" required />
    </div>
    
    <div class="row">
        <div class="field">
            <label>📅 Дата начала</label>
            <input asp-for="StartDate" type="date" required />
        </div>
        <div class="field">
            <label>📅 Дата окончания</label>
            <input asp-for="EndDate" type="date" required />
        </div>
    </div>
    
    <div class="field">
        <label>📝 Описание</label>
        <textarea asp-for="Description" rows="3"></textarea>
    </div>
    
    <div class="field">
        <label>🏢 Заказчик (ID из реестра)</label>
        <input asp-for="CustomerId" type="number" />
        <small style="color:#666;">Сначала создайте заказчика в разделе "Заказчики"</small>
    </div>
    
    <div class="field">
        <label>💰 Налоговая ставка (%)</label>
        <input asp-for="TaxRate" type="number" step="0.01" value="20" />
    </div>
    
    <button type="submit" class="btn">✅ Создать проект</button>
    <a href="/Projects" class="btn-secondary">❌ Отмена</a>
</form>