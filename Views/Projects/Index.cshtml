@model X.PagedList.IPagedList<WebWorkNew.Models.Project>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Управление проектами";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Управление проектами</h2>

<div style="margin-bottom: 20px; display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
    <a href="/Projects/Create" class="btn">➕ Создать проект</a>

    <form asp-action="Index" method="get" style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
        <input type="text" name="search" class="form-control" placeholder="Поиск по названию, описанию, заказчику"
               value="@(ViewBag.CurrentSearch ?? "")" style="min-width:340px;" />

        <button class="btn btn-primary" type="submit">Найти</button>

        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.CurrentSearch))
        {
            <a class="btn btn-secondary" asp-action="Index">Сбросить</a>
        }

        <select name="pageSize" class="form-select" onchange="this.form.submit()" style="width:120px;">
            @foreach (var s in new[] { 10, 25, 50, 100 })
            {
                <option value="@s" selected="@(ViewBag.CurrentPageSize == s ? "selected" : null)">@s</option>
            }
        </select>
    </form>
</div>

<table class="data-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название проекта</th>
            <th>Статус</th>
            <th>Срок выполнения</th>
            <th>Стоимость</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Title</td>
                <td>@(p.EndDate >= DateTime.Today ? " Активен" : " Завершен")</td>
                <td>@p.StartDate.ToString("dd.MM.yyyy") - @p.EndDate.ToString("dd.MM.yyyy")</td>
                <td>@p.TotalCostWithMargin.ToString("N2") ₽</td>

                <td>
                    <a href="/Projects/Edit/@p.Id" class="btn-secondary" style="padding:4px 8px;"> Реквизиты</a>
                    <a href="/Projects/Resources/@p.Id" class="btn-secondary" style="padding:4px 8px;"> Ресурсы</a>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
                        <a href="/api/Documents/project/@p.Id/commercial-offer/pdf" class="btn-secondary" style="padding:4px 8px;">📄 КП PDF</a>
                        <a href="/api/Documents/project/@p.Id/commercial-offer/excel" class="btn-secondary" style="padding:4px 8px;">📊 КП Excel</a>
                        <a href="/api/Documents/project/@p.Id/commercial-offer/word" class="btn-secondary" style="padding:4px 8px;">📝 КП Word</a>
                        <a href="/api/Documents/project/@p.Id/nma/pdf" class="btn-secondary" style="padding:4px 8px;">📄 НМА PDF</a>
                        <a href="/api/Documents/project/@p.Id/nma/excel" class="btn-secondary" style="padding:4px 8px;">📊 НМА Excel</a>
                        <a href="/api/Documents/project/@p.Id/nma/word" class="btn-secondary" style="padding:4px 8px;">📝 НМА Word</a>
                    </div>
                </td>
            </tr>
        }

        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Нет проектов</td>
            </tr>
        }
    </tbody>
</table>

<div style="margin-top:16px; display:flex; justify-content:center;">
    @Html.PagedListPager(Model, page => Url.Action("Index", new
    {
        page,
        search = ViewBag.CurrentSearch,
        pageSize = ViewBag.CurrentPageSize
    }))
</div>

