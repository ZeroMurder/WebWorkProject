@model WebWorkNew.Models.Subcontractor
@using WebWorkNew.Enums

@{
    ViewData["Title"] = "Редактировать субподрядчика";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Редактировать субподрядчика</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="field">
        <label asp-for="Inn">ИНН</label>
        <input asp-for="Inn" />
    </div>

    <div class="field">
        <label asp-for="Name">Название (ЮЛ/ИП)</label>
        <input asp-for="Name" />
    </div>

    <div class="field">
        <label asp-for="ContactName">ФИО контактного лица</label>
        <input asp-for="ContactName" />
    </div>

    <div class="field">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" />
    </div>

    <div class="field">
        <label asp-for="Phone">Телефон</label>
        <input asp-for="Phone" />
    </div>

    <div class="field">
        <label asp-for="Unit">Единица измерения</label>
        <select asp-for="Unit" asp-items="Html.GetEnumSelectList<TimeUnit>()"></select>
    </div>

    <div class="field">
        <label asp-for="CostPerUnit">Стоимость услуг за единицу</label>
        <input asp-for="CostPerUnit" type="number" step="any" />
    </div>

    <div class="field">
        <label asp-for="TaxRate">Налоговая ставка, %</label>
        <input asp-for="TaxRate" type="number" step="any" />
    </div>

    <button type="submit" class="btn">Сохранить</button>
</form>

<p>
    <a class="btn secondary" href="/Subcontractors"> К списку</a>
</p>

