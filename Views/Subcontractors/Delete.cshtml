@model WebWorkNew.Models.Subcontractor

@{
    ViewData["Title"] = "Удалить субподрядчика";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Удалить субподрядчика</h2>

<p>Уверены, что хотите удалить субподрядчика <b>@Model.Name</b> (ИНН: @Model.Inn)?</p>

<form asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn">Да, удалить</button>
    <a class="btn secondary" href="/Subcontractors">Отмена</a>
</form>

