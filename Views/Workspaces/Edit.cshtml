@model WebWorkNew.Models.Workspace
@{
    ViewData["Title"] = "Редактирование рабочей области";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <h2>✏️ Редактирование рабочей области</h2>
    
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        <div class="field">
            <label asp-for="Name">Название рабочей области *</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        
        <div class="field">
            <label asp-for="Subdomain">Поддомен *</label>
            <div style="display: flex; align-items: center;">
                <input asp-for="Subdomain" class="form-control" style="flex: 1;" />
                <span style="margin-left: 10px; color: #666;">.iqnix.tech</span>
            </div>
            <span asp-validation-for="Subdomain" class="text-danger"></span>
        </div>
        
        <div style="margin-top: 20px;">
            <button type="submit" class="btn">💾 Сохранить</button>
            <a href="/Workspaces" class="btn-secondary">Отмена</a>
        </div>
    </form>
</div>