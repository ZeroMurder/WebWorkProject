@model List<WebWorkNew.Models.Workspace>
@{
    ViewData["Title"] = "Рабочие области";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
    <div class="col-md-4">
        <input type="text" id="searchInput" class="form-control" placeholder="Поиск по названию..." />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" onclick="searchProjects()">Найти</button>
    </div>
</div>

<script>
    function searchProjects() {
        var search = document.getElementById('searchInput').value;
        window.location.href = '/Projects?search=' + encodeURIComponent(search);
    }
</script>
<h2>🏢 Рабочие области</h2>
@if (User.IsInRole("GlobalAdmin"))
{
    <a href="/Workspaces/Create" class="btn">➕ Создать</a>
}
<table class="table">
    <thead><tr><th>Название</th><th>Поддомен</th><th>Действия</th></tr></thead>
    <tbody>
        @foreach (var w in Model)
        {
            <tr>
                <td>@w.Name</td>
                <td>@w.Subdomain</td>
                <td>
                    <a href="/Workspaces/Details/@w.Id">Открыть</a>
                    <a href="/Workspaces/ManageUsers/@w.Id">Участники</a>
@if (User.IsInRole("GlobalAdmin") || w.AdminUserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <a href="/Workspaces/Edit/@w.Id">✏️</a>
                        <form asp-action="Delete" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@w.Id" />
                            <button type="submit" onclick="return confirm('Удалить?')" class="btn-link">🗑️</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>