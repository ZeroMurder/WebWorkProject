@model WebWorkNew.Controllers.EditUserViewModel
@{
    ViewData["Title"] = "Редактирование пользователя";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Identity.IdentityRole>;
    var workspaces = ViewBag.Workspaces as List<WebWorkNew.Models.Workspace>;
}

<div class="card">
    <h2>✏️ Редактирование пользователя</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
            <div>
                <div class="field">
                    <label asp-for="LastName">Фамилия *</label>
                    <input asp-for="LastName" class="form-control" required />
                </div>

                <div class="field">
                    <label asp-for="FirstName">Имя *</label>
                    <input asp-for="FirstName" class="form-control" required />
                </div>

                <div class="field">
                    <label asp-for="MiddleName">Отчество</label>
                    <input asp-for="MiddleName" class="form-control" />
                </div>

                <div class="field">
                    <label asp-for="Position">Должность *</label>
                    <input asp-for="Position" class="form-control" required />
                </div>
            </div>

            <div>
                <div class="field">
                    <label asp-for="Email">Email *</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>

                <div class="field">
                    <label asp-for="Role">Роль</label>
                    <select asp-for="Role" class="form-control">
                        <option value="">-- Выберите роль --</option>
                        @if (roles != null)
                        {
                            foreach (var role in roles)
                            {
                                <option value="@role.Name">@role.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="field" style="margin-top:16px;">
            <label>Рабочие области</label>

            <div style="border:1px solid #ddd; border-radius:8px; padding:15px; max-height:320px; overflow-y:auto;">
                @if (workspaces != null && workspaces.Any())
                {
                    foreach (var ws in workspaces)
                    {
                        var isChecked = Model.WorkspaceIds != null && Model.WorkspaceIds.Contains(ws.Id);
                        var perms = (isChecked && Model.WorkspacePermissions != null && Model.WorkspacePermissions.ContainsKey(ws.Id))
                            ? Model.WorkspacePermissions[ws.Id]
                            : null;

                        <div style="margin-bottom:15px; padding:10px; border:1px solid #eee; border-radius:8px;">
                            <label style="display:flex; align-items:center; gap:10px;">
                                <input type="checkbox"
                                       name="WorkspaceIds"
                                       value="@ws.Id"
                                       @(isChecked ? "checked" : "")
                                       onchange="toggleWorkspacePermissions(this, @ws.Id)" />
                                <strong>@ws.Name</strong> (@ws.Subdomain)
                            </label>

                            <div id="perms-@ws.Id"
                                 style="margin-left:30px; margin-top:10px; display:@(isChecked ? "block" : "none");">
                                <label style="display:block; margin-right:15px; margin-bottom:8px;">
                                    <input type="checkbox"
                                           name="WorkspacePermissions[@ws.Id].CanEdit"
                                           value="true"
                                           @(perms != null && perms.CanEdit ? "checked" : "") />
                                    Редактирование проектов
                                </label>

                                <label style="display:block;">
                                    <input type="checkbox"
                                           name="WorkspacePermissions[@ws.Id].CanManage"
                                           value="true"
                                           @(perms != null && perms.CanManage ? "checked" : "") />
                                    Управление областью
                                </label>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="color:#666; margin:0;">Нет доступных рабочих областей</p>
                }
            </div>
        </div>

        <div style="margin-top:20px;">
            <button type="submit" class="btn">💾 Сохранить</button>
            <a href="/AdminUsers" class="btn-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts{
    <script>
        function toggleWorkspacePermissions(checkbox, workspaceId) {
            var permsDiv = document.getElementById('perms-' + workspaceId);
            if (!permsDiv) return;
            permsDiv.style.display = checkbox.checked ? 'block' : 'none';
        }
    </script>
}

