@model List<WebWorkNew.Models.ApplicationUser>
@{
    ViewData["Title"] = "Управление пользователями";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

@{
    // "Золотое" имя админа и роль
    var adminName = User.Identity?.Name ?? "Администратор";
    var adminRole = User.IsInRole("GlobalAdmin") ? "GlobalAdmin" : "Admin";
}

<div class="card" style="position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.14);">
    <div style="position:absolute; inset:-2px; background: linear-gradient(90deg, rgba(124,58,237,.9), rgba(34,211,238,.85), rgba(255,215,0,.75)); filter: blur(18px); opacity:.35; pointer-events:none;"></div>

    <div style="position: relative;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom: 14px;">
            <div>
                <div style="display:flex; align-items:center; gap:12px;">
                    <div style="width:44px; height:44px; border-radius:14px; background: rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); display:flex; align-items:center; justify-content:center; box-shadow: 0 0 26px rgba(34,211,238,.18);">👑</div>
                    <div>
                        <h2 style="margin:0; font-size:22px; letter-spacing:.2px;">
                            🧿 Админ-панель
                        </h2>
                        <div style="margin-top:6px; color: rgba(234,242,255,.78); font-weight:600; font-size:13px;">
                            <span style="color:#FFD166; text-shadow: 0 0 18px rgba(255,209,102,.25);">Имя:</span>
                            <span style="font-weight:800;">@adminName</span>
                            &nbsp;•&nbsp;
                            <span style="color:#67E8F9; text-shadow: 0 0 18px rgba(103,232,249,.25);">Роль:</span>
                            <span style="font-weight:900; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 3px;">
                                @adminRole
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end;">
                <a href="/AdminUsers/Create" class="btn">➕ Создать пользователя</a>
                <button class="btn-secondary" type="button" onclick="openAdminHelp()" style="border-radius:12px; padding:10px 18px; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.08);">
                    ⛭ DevTools / F12 подсказка
                </button>
                <a href="/swagger/index.html" class="btn-secondary" style="border-radius:12px; padding:10px 18px; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.08);" title="Swagger UI">
                    📚 Swagger
                </a>
            </div>
        </div>

            <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" id="searchInput" class="form-control" placeholder="Поиск по названию..." />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary" onclick="searchProjects()">Найти</button>
        </div>
    </div>

    <script>
        function searchProjects() {
            var search = document.getElementById('searchInput').value;
            window.location.href = '/Projects?search=' + encodeURIComponent(search);
        }
    </script>

        <div style="margin-bottom:14px; padding:12px 14px; border:1px solid rgba(255,255,255,.14); background: rgba(0,0,0,.18); border-radius:14px;">
            <div style="font-weight:800; letter-spacing:.2px; margin-bottom:6px;">💠 Супер-возможности админа</div>
            <div style="color: rgba(234,242,255,.78); font-size:13px; line-height:1.5;">
                • Быстрый доступ к ролям/пользователям<br/>
                • Удаление/редактирование с проверкой<br/>
                • Всплывающие подсказки по пунктам интерфейса<br/>
                • Подсказка “как настроить помощь через VS Code + GitHub” (через кнопки)
            </div>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Фамилия</th>
                    <th>Имя</th>
                    <th>Email</th>
                    <th>Должность</th>
                    <th>Роли</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var roles = userRoles?.ContainsKey(user.Id) == true ? userRoles[user.Id] : new List<string>();
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.LastName</td>
                        <td>@user.FirstName</td>
                        <td>@user.Email</td>
                        <td>@user.Position</td>
                        <td>
                            <span title="Роли пользователя" style="color:#A5F3FC; text-shadow: 0 0 14px rgba(165,243,252,.18); font-weight:800;">
                                @string.Join(", ", roles)
                            </span>
                        </td>
                        <td>
                            <a href="/AdminUsers/Edit/@user.Id" class="btn-secondary" style="padding: 4px 8px; border-radius:10px;" title="Редактировать">
                                ✏️ Редактировать
                            </a>
                            <form asp-action="Delete" method="post" style="display: inline;" onsubmit="return confirm('Удалить пользователя @user.LastName @user.FirstName?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn-secondary" style="background:#dc3545; padding: 4px 8px; border-radius:10px;" title="Удалить">
                                    🗑️ Удалить
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function openAdminHelp() {
            const existing = document.getElementById('adminHelpModal');
            if (existing) existing.remove();

            const overlay = document.createElement('div');
            overlay.id = 'adminHelpModal';
            overlay.style.position = 'fixed';
            overlay.style.inset = 0;
            overlay.style.background = 'rgba(0,0,0,.65)';
            overlay.style.zIndex = 9999;
            overlay.style.display = 'flex';
            overlay.style.alignItems = 'center';
            overlay.style.justifyContent = 'center';

            const modal = document.createElement('div');
            modal.style.width = 'min(900px, 92vw)';
            modal.style.borderRadius = '18px';
            modal.style.border = '1px solid rgba(255,255,255,.18)';
            modal.style.background = 'linear-gradient(180deg, rgba(10,16,34,.96), rgba(7,10,18,.94))';
            modal.style.boxShadow = '0 30px 120px rgba(0,0,0,.6)';
            modal.style.padding = '18px 18px 14px';
            modal.style.position = 'relative';
            modal.style.overflow = 'hidden';

            modal.innerHTML = `
                <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
                    <div>
                        <div style="font-size:14px; color: rgba(234,242,255,.78); font-weight:700;">💎 Быстрые подсказки для Админа</div>
                        <div style="font-size:22px; font-weight:900; margin-top:6px;">
                            DevTools (F12) • VS Code • GitHub.io настройка
                        </div>
                    </div>
                    <button onclick="this.closest('#adminHelpModal').remove();" style="padding:10px 14px; border-radius:12px; border:1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.08); color:#EAF2FF; font-weight:800; cursor:pointer;">✕</button>
                </div>

                <div style="margin-top:14px; display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                    <div style="padding:14px; border-radius:14px; border:1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04);">
                        <div style="font-weight:900; color:#67E8F9; text-shadow: 0 0 16px rgba(103,232,249,.25);">1) Быстрые кнопки Админа</div>
                        <ul style="margin:10px 0 0; padding-left:18px; color: rgba(234,242,255,.80); font-size:13px; line-height:1.6;">
                            <li>“Swagger” открывает документацию API</li>
                            <li>Редактирование/Удаление пользователя — из таблицы</li>
                            <li>Подсказки навигации — далее добавим сохранение в БД</li>
                        </ul>
                    </div>

                    <div style="padding:14px; border-radius:14px; border:1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04);">
                        <div style="font-weight:900; color:#FFD166; text-shadow: 0 0 16px rgba(255,209,102,.25);">2) VS Code + GitHub.io</div>
                        <div style="margin-top:8px; color: rgba(234,242,255,.80); font-size:13px; line-height:1.6;">
                            • В VS Code включите расширения (C# Dev Kit / Azure / .NET)
                            • GitHub Pages: создайте repo <b>username.github.io</b>
                            • Деплой: build через workflow или вручную (если статический сайт)
                            <div style="margin-top:10px; color: rgba(234,242,255,.70); font-size:12px;">Примечание: это подсказка UI. Реальную настройку можно подключить отдельно.</div>
                        </div>
                    </div>
                </div>

                <div style="margin-top:14px; padding-top:12px; border-top:1px solid rgba(255,255,255,.12); color: rgba(234,242,255,.75); font-size:13px; line-height:1.6;">
                    В следующем шаге добавлю: <b>выбор меню/навигации</b> “как удобно пользователю” с сохранением в БД.
                </div>
            `;

            modal.querySelectorAll('a').forEach(a => {
                a.target = '_blank';
            });

            overlay.appendChild(modal);
            overlay.addEventListener('click', (e) => {
                if (e.target === overlay) overlay.remove();
            });

            document.body.appendChild(overlay);
        }
    </script>
}

