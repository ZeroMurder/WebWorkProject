@model WebWork.Models.Employee

@{
    ViewData["Title"] = "Удалить сотрудника";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Удалить сотрудника</h2>

<p>Уверены, что хотите удалить сотрудника: <b>@Model.Surname</b> <b>@Model.Name</b>?</p>

<form asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn">Да, удалить</button>
    <a class="btn secondary" href="/Employees">Отмена</a>
</form>

