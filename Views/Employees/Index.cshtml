@model IEnumerable<WebWork.Models.Employee>

@{
    ViewData["Title"] = "Реестр сотрудников";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Реестр сотрудников</h2>

<p>
    <a class="btn" href="/Employees/Create">➕ Создать сотрудника</a>
</p>

<table>
    <thead>
    <tr>
        <th>ID</th>
        <th>Фамилия</th>
        <th>Имя</th>
        <th>Должность</th>
        <th>Оклад/мес</th>
        <th>Налог, %</th>
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Id</td>
            <td>@e.Surname</td>
            <td>@e.Name</td>
            <td>@e.Position</td>
            <td>@e.MonthlySalary</td>
            <td>@e.TaxRate</td>
            <td>
                <a class="btn secondary" href="/Employees/Edit/@e.Id">✏️ Edit</a>
                <a class="btn secondary" href="/Employees/Delete/@e.Id">🗑️ Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

